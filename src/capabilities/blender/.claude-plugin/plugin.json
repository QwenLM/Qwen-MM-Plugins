{
  "name": "qwen-mm-plugins-blender",
  "version": "1.1.0",
  "description": "Create, refine, and render 3D scenes and assets in Blender.",
  "skills": [
    "./skill"
  ],
  "mcpServers": {
    "qwen-mm-plugins-blender": {
      "command": "uvx",
      "args": [
        "--from",
        "qwen-mm-plugins[blender] @ git+https://github.com/QwenLM/Qwen-MM-Plugins.git@qwen-mm-plugins-blender-v1.1.0",
        "qwen-mm-plugins-blender"
      ],
      "env": {
        "QWEN_MM_AUTOLAUNCH": "1"
      }
    }
  }
}
