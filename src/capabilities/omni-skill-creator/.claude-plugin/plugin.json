{
  "name": "qwen-mm-plugins-omni-skill-creator",
  "version": "1.0.0",
  "description": "Turns a demonstration video into a reusable Agent Skill. Needs a DashScope key and ffmpeg.",
  "skills": [
    "./skill"
  ],
  "mcpServers": {
    "qwen-mm-plugins-omni-skill-creator": {
      "command": "uvx",
      "args": [
        "--from",
        "qwen-mm-plugins[omni-skill-creator] @ git+https://github.com/QwenLM/Qwen-MM-Plugins.git@qwen-mm-plugins-omni-skill-creator-v1.0.0",
        "qwen-mm-plugins-omni-skill-creator"
      ]
    }
  }
}
